rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read any user profile (for search/friend features)
      allow read: if isAuthenticated();
      
      // Users can only write to their own profile
      allow write: if isOwner(userId);
      
      // Friends subcollection
      match /friends/{friendId} {
        // Owner can read/write their own friends
        allow read, write: if isOwner(userId);
        
        // Allow another user to add themselves as a friend (accepting a request)
        // The friendId in the path must match the authenticated user
        allow create, update: if isAuthenticated() && isOwner(friendId);
        
        // Allow a user to remove themselves from someone's friend list
        allow delete: if isAuthenticated() && isOwner(friendId);
      }
      
      // Friend requests (incoming) subcollection
      match /friendRequests/{requesterId} {
        // Owner can read/write their own friend requests
        allow read, write: if isOwner(userId);
        
        // Allow another user to send a friend request to this user
        // The requesterId must match the authenticated user (sender)
        allow create: if isAuthenticated() && isOwner(requesterId);
        
        // Allow the sender to cancel their own request
        allow delete: if isAuthenticated() && isOwner(requesterId);
      }
      
      // Sent friend requests (outgoing) subcollection
      match /sentFriendRequests/{targetId} {
        // Owner can read/write their own sent requests
        allow read, write: if isOwner(userId);
        
        // Allow the target user to delete this sent request (when accepting/declining)
        allow delete: if isAuthenticated() && isOwner(targetId);
      }
      
      // Activity likes subcollection
      match /activityLikes/{activityId} {
        allow read, write: if isOwner(userId);
      }
      
      // Joined challenges subcollection
      match /joinedChallenges/{challengeId} {
        allow read, write: if isOwner(userId);
      }
      
      // Premium subscription subcollection
      match /subscription/{docId} {
        allow read, write: if isOwner(userId);
      }
      
      // Habits subcollection
      match /habits/{habitId} {
        allow read, write: if isOwner(userId);
      }
      
      // Logs subcollection (habit completion logs)
      match /logs/{logId} {
        allow read, write: if isOwner(userId);
      }
      
      // Gamification subcollection
      match /gamification/{docId} {
        allow read, write: if isOwner(userId);
      }
      
      // Settings subcollection
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Activity feed (global)
    match /activity/{activityId} {
      // Authenticated users can read all activities
      allow read: if isAuthenticated();
      
      // Users can only create/update their own activities
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Challenges collection
    match /challenges/{challengeId} {
      // Authenticated users can read public challenges
      allow read: if isAuthenticated();
      
      // Only allow creating challenges for authenticated users
      allow create: if isAuthenticated();
      
      // Challenge participants subcollection
      match /participants/{participantId} {
        allow read: if isAuthenticated();
        // Users can only write their own participant entry
        allow write: if isAuthenticated() && isOwner(participantId);
      }
    }
    
    // Leaderboard collection
    match /leaderboard/{timeFrame}/entries/{userId} {
      allow read: if isAuthenticated();
      // Users can only update their own leaderboard entry
      allow write: if isAuthenticated() && isOwner(userId);
    }
  }
}
